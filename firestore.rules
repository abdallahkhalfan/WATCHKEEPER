rules_version = '2';

service cloud.firestore {
      match /databases/{database}/documents {

            function signed() {
                      return request.auth != null;
            }

                function owner(uid) {
                          return signed() && request.auth.uid == uid;
                }

                    // =========================
                        // USERS
                            // =========================
                                match /users/{uid} {
                                          // Public/basic profile only.
                                                allow read: if signed();

                                                      allow create: if owner(uid);
                                                            allow update, delete: if owner(uid);

                                                                  // Private owner-only data.
                                                                        match /planner/{id} {
                                                                                    allow read, write: if owner(uid);
                                                                        }

                                                                              match /memories/{id} {
                                                                                        allow read, write: if owner(uid);
                                                                              }

                                                                                    match /keeper_messages/{id} {
                                                                                                allow read, write: if owner(uid);
                                                                                    }

                                                                                          match /settings/{id} {
                                                                                                    allow read, write: if owner(uid);
                                                                                          }

                                                                                                match /private/{id} {
                                                                                                            allow read, write: if owner(uid);
                                                                                                }

                                                                                                      // Deny unknown user subcollections.
                                                                                                            match /{sub}/{id} {
                                                                                                                        allow read, write: if false;
                                                                                                            }
                                }

                                    // =========================
                                        // CONVERSATIONS
                                            // =========================
                                                match /conversations/{cid} {

                                                          function member() {
                                                                    return signed()
                                                                              && request.auth.uid in resource.data.members;
                                                          }

                                                                function memberAfterWrite() {
                                                                            return signed()
                                                                                      && request.auth.uid in request.resource.data.members;
                                                                }

                                                                      allow read: if member();

                                                                            allow create: if memberAfterWrite()
                                                                                    && request.resource.data.members is list
                                                                                            && request.resource.data.members.size() >= 2;

                                                                                                  // Members cannot rewrite the membership list.
                                                                                                        allow update: if member()
                                                                                                                && request.resource.data.members == resource.data.members;

                                                                                                                      allow delete: if false;

                                                                                                                            match /messages/{mid} {

                                                                                                                                        function parentConversation() {
                                                                                                                                                      return get(
                                                                                                                                                                    /databases/$(database)/documents/conversations/$(cid)
                                                                                                                                                      );
                                                                                                                                        }

                                                                                                                                                function messageMember() {
                                                                                                                                                              return signed()
                                                                                                                                                                          && request.auth.uid
                                                                                                                                                                                         in parentConversation().data.members;
                                                                                                                                                }

                                                                                                                                                        allow read: if messageMember();

                                                                                                                                                                allow create: if messageMember()
                                                                                                                                                                          && request.resource.data.senderId == request.auth.uid;

                                                                                                                                                                                  allow update: if false;

                                                                                                                                                                                          allow delete: if messageMember()
                                                                                                                                                                                                    && resource.data.senderId == request.auth.uid;
                                                                                                                            }
                                                }

                                                    // =========================
                                                        // DEFAULT DENY
                                                            // =========================
                                                                match /{document=**} {
                                                                          allow read, write: if false;
                                                                }
      }
}
                                                                }
                                                                                                                                                }
                                                                                                                                                      )
                                                                                                                                        }
                                                                                                                            }
                                                                }
                                                          }
                                                }
                                                                                                            }
                                                                                                }
                                                                                          }
                                                                                    }
                                                                              }
                                                                        }
                                }
                }
            }
      }
}